menuconfig WEBOS_ADB
	bool "WebOS ADB-compatible device service"
	help
	  Enable the bounded ADB protocol engine. A transport is required before
	  a host can connect.

if WEBOS_ADB

config WEBOS_ADB_USB
	bool "ADB transport over USB"
	default y
	depends on USB_DEVICE_STACK_NEXT
	help
	  Expose an ADB vendor interface through Zephyr's USB device stack.

config WEBOS_ADB_ALLOW_NO_AUTH
	bool "Allow unauthenticated ADB (development only)"
	default n
	help
	  Allow the host to enter the ADB device state without authenticating.
	  This is suitable only for explicitly development firmware and must
	  remain disabled in production builds.

config WEBOS_ADB_MAX_PAYLOAD
	int "Maximum negotiated ADB payload"
	default 4096
	range 256 16384

config WEBOS_ADB_USB_TRANSFER_SIZE
	int "USB transfer buffer size"
	default 512
	range 64 4096
	depends on WEBOS_ADB_USB
	help
	  Size of the reusable USB OUT request and the largest outbound payload
	  supported by the initial enumeration implementation.

config WEBOS_ADB_USB_TX_QUEUE_DEPTH
	int "Queued ADB packets"
	default 6
	range 2 16
	depends on WEBOS_ADB_USB
	help
	  Serialize control and stream packets while one USB IN transfer is active.

config WEBOS_ADB_USB_VID
	hex "USB vendor ID"
	default 0x303a
	depends on WEBOS_ADB_USB
	help
	  Development default for the ESP32-S3 prototype. Assign a project-owned
	  VID before distributing hardware.

config WEBOS_ADB_USB_PID
	hex "USB product ID"
	default 0x4002
	depends on WEBOS_ADB_USB

config WEBOS_ADB_USB_MANUFACTURER
	string "USB manufacturer string"
	default "WebOS"
	depends on WEBOS_ADB_USB

config WEBOS_ADB_USB_PRODUCT
	string "USB product string"
	default "WebOS ESP32-S3 ADB"
	depends on WEBOS_ADB_USB

config WEBOS_ADB_TX_PAYLOAD_SIZE
	int "Maximum service TX payload"
	default 512
	range 64 WEBOS_ADB_MAX_PAYLOAD
	help
	  Size of each router-owned service output slot. Transports must accept
	  packets at least this large.

config WEBOS_ADB_MAX_STREAMS
	int "Maximum simultaneous ADB streams"
	default 2
	range 1 8

config WEBOS_ADB_SHELL
	bool "Bounded ADB shell service"
	default n
	depends on WEBOS_SHELL_EXEC
	help
	  Route allowlisted shell:<command> streams and bounded legacy
	  interactive shell: sessions to Zephyr's shared dummy shell backend.
	  Interactive sessions can invoke any registered shell command, so they
	  must not be exposed through an unauthenticated production build.
	  shell_v2 is not advertised.

config WEBOS_ADB_SHELL_COMMAND_SIZE
	int "Maximum ADB shell command size"
	default 256
	range 32 1024
	depends on WEBOS_ADB_SHELL

config WEBOS_ADB_SHELL_OUTPUT_SIZE
	int "Maximum captured ADB shell output"
	default 512
	range 128 4096
	depends on WEBOS_ADB_SHELL

config WEBOS_ADB_SHELL_INPUT_SIZE
	int "Maximum buffered interactive shell input"
	default 4096
	range WEBOS_ADB_SHELL_COMMAND_SIZE 16384
	depends on WEBOS_ADB_SHELL
	help
	  Bound input waiting behind shell output acknowledgements independently
	  of the maximum length of one command line.

config WEBOS_ADB_SHELL_MAX_STREAMS
	int "Maximum concurrent ADB shell streams"
	default 1
	range 1 4
	depends on WEBOS_ADB_SHELL

config WEBOS_ADB_SYNC
	bool "Legacy ADB sync push service"
	default n
	help
	  Enable bounded legacy SEND/DATA/DONE uploads below /STORAGE:.

config WEBOS_ADB_SYNC_PATH_MAX
	int "Maximum sync destination path"
	default 128
	range 64 512
	depends on WEBOS_ADB_SYNC

config WEBOS_ADB_SYNC_DATA_MAX
	int "Maximum legacy sync DATA record"
	default 65536
	range 4096 65536
	depends on WEBOS_ADB_SYNC
	help
	  This is a wire validation limit, not an allocation size. DATA records
	  are streamed from bounded ADB payload slices directly to the file.

config WEBOS_ADB_REBOOT
	bool "ADB reboot service"
	default n
	select REBOOT
	help
	  Accept the standard reboot: ADB service and perform a cold reboot.
	  Android-specific reboot targets are rejected.

config WEBOS_ADB_REBOOT_DELAY_MS
	int "Delay before an ADB-requested reboot"
	default 250
	range 50 5000
	depends on WEBOS_ADB_REBOOT
	help
	  Give the ADB OKAY response time to reach the host before rebooting.

endif
